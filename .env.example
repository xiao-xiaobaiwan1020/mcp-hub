# 复制为 .env 并按需修改（本文件仅作示例，程序不会自动加载 .env）
# 启动方式： python -m mcp_hub

MCP_HUB_HOST=0.0.0.0
MCP_HUB_PORT=8765

# 心跳：建议 Agent 每 10 秒一次，30 秒未心跳判定离线
MCP_HUB_HEARTBEAT_INTERVAL=10
MCP_HUB_HEARTBEAT_TIMEOUT=30

# 离线 Agent 在注册表中保留 600 秒（0 = 永不清理）
MCP_HUB_OFFLINE_RETENTION=600

# 每个 Agent 的待投递队列上限
MCP_HUB_QUEUE_SIZE=200

# 管理接口令牌（对外暴露时强烈建议设置）
MCP_HUB_ADMIN_TOKEN=change-me

# 监测平台 Webhook（逗号分隔）
MCP_HUB_WEBHOOK_URLS=

# 日志
MCP_HUB_LOG_LEVEL=INFO
MCP_HUB_LOG_JSON=0
